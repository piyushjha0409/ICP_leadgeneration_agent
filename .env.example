OPENROUTER_API_KEY= # OpenRouter API key (https://openrouter.ai/keys) — free tier: ~20 req/min, 50 req/day
FIRECRAWL_API_KEY= # Firecrawl web search (https://firecrawl.dev) — free, no card, 1000 credits/mo (2 per search); the default provider
TAVILY_API_KEY= # Tavily web search (https://tavily.com) — free, no card, 1000 credits/mo (1 per search); fallback when Firecrawl errors, or primary via SEARCH_PROVIDER
HUNTER_API_KEY= # Hunter.io API key for email enrichment (optional)

# Search — with neither key set, hunt skips every angle and scan runs homepage-only.
SEARCH_PROVIDER= # firecrawl | tavily | auto (default: auto = Firecrawl first if its key is set, else Tavily; the other is an error fallback)
FIRECRAWL_MAX_RPM= # client-side search requests/min ceiling (default: 10 = the free plan's limit; Hobby+ allows 100)
FIRECRAWL_CONCURRENCY= # in-flight Firecrawl searches (default: 2 = the free plan's limit; Hobby allows 5)
FIRECRAWL_SCRAPE_RESULTS= # 1 to have Firecrawl scrape each result into markdown (+1 credit per result, slower; default off)

# Models — defaults are OpenRouter `:free` variants, so a run costs $0.
OPENROUTER_MODEL_STRATEGIST= # default: nvidia/nemotron-3-ultra-550b-a55b:free (icp, qualify, pitch angles)
OPENROUTER_MODEL_OPERATOR= # default: nvidia/nemotron-3-super-120b-a12b:free (hunt, scan, drafts)

# Upgrade path: a one-time $10 credit purchase on the OpenRouter account lifts
# the `:free` daily allowance from 50 to 1000 requests/day (per-minute stays
# 20, and the models themselves stay $0). After that, raise the RAINMAKER_*
# caps below, or point the two model vars at paid ids such as
# openai/gpt-5.6-sol / openai/gpt-5.6-luna.
OPENROUTER_MAX_RPM= # client-side requests/min ceiling (default: 15, under OpenRouter's 20)

# Pipeline caps — defaults sized for the 50-requests/day free tier (~23 calls/run, ~24 searches/run).
RAINMAKER_MAX_ANGLES= # default: 4
RAINMAKER_PER_ANGLE= # default: 5
RAINMAKER_MAX_CANDIDATES= # default: 10
RAINMAKER_TOP_N= # default: 5
RAINMAKER_HUNT_CONCURRENCY= # default: 2
RAINMAKER_SCAN_CONCURRENCY= # default: 2
RAINMAKER_BRIEF_CONCURRENCY= # default: 2
